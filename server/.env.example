# --- LLM cache server config ---
# Copy this file to `.env` and fill in your key.  `.env` is gitignored.

# Your OpenAI-compatible API key (kept server-side, never sent to the browser).
LLM_API_KEY=

# OpenAI-compatible base URL (do NOT include /chat/completions).
LLM_BASE_URL=https://api.deepseek.com/v1

# Model name.
LLM_MODEL=deepseek-chat

# Sampling temperature (lower = more deterministic).
LLM_TEMPERATURE=0.2

# Port to listen on.
PORT=3939

# Where to persist the analysis cache. Files are written as
# DATA_DIR/<anime>/<episode>.json (plus an analyses.jsonl append log).
# DATA_DIR=./data

# Optional: serve the built asbplayer SPA from this folder (same origin = no CORS).
# Point it at the client build output, e.g. ../client/dist
# PUBLIC_DIR=

# Optional: allow the browser to override key/baseUrl/model per request
# (useful if each friend uses their own key). Default false.
# ALLOW_CLIENT_KEY=false

# --- Word pronunciation via VOICEVOX (local, free, natural JP voices) ---
# Install/run the VOICEVOX engine (https://voicevox.hiroshiba.jp/), it listens
# on 127.0.0.1:50021. The server proxies it at GET /api/tts to avoid browser CORS.
# VOICEVOX_URL=http://127.0.0.1:50021
# Speaker/style id (list them at GET http://127.0.0.1:50021/speakers). 1 = default.
# VOICEVOX_SPEAKER=1

