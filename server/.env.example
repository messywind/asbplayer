# --- Multi-user account configuration ---
# Copy this file to `.env`. The first start creates the administrator account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Used to encrypt every user's LLM API Key at rest. Keep this stable: changing
# it makes already-saved keys unreadable. Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters

# Set true when the public site is served exclusively over HTTPS.
SECURE_COOKIES=false
SESSION_DAYS=30

# --- Shared LLM model configuration ---
# Every user supplies their own API Key in the account center. The endpoint and
# model are server-controlled so identical lines can share one global cache.

# OpenAI-compatible base URL (do NOT include /chat/completions).
LLM_BASE_URL=https://api.deepseek.com/v1

# Model name.
LLM_MODEL=deepseek-chat

# Sampling temperature (lower = more deterministic).
LLM_TEMPERATURE=0.2

# Port to listen on.
PORT=3939

# Directory and SQLite file used for accounts, archives, and shared analyses.
# DATA_DIR=./data
# DATABASE_PATH=./data/asbplayer.sqlite

# Optional: serve the built asbplayer SPA from this folder (same origin = no CORS).
# Point it at the client build output, e.g. ../client/dist
# PUBLIC_DIR=

# --- Word pronunciation via VOICEVOX (local, free, natural JP voices) ---
# Install/run the VOICEVOX engine (https://voicevox.hiroshiba.jp/), it listens
# on 127.0.0.1:50021. The server proxies it at GET /api/tts to avoid browser CORS.
# VOICEVOX_URL=http://127.0.0.1:50021
# Speaker/style id (list them at GET http://127.0.0.1:50021/speakers). 1 = default.
# VOICEVOX_SPEAKER=1
